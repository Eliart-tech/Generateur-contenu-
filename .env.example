# Copie ce fichier vers .env puis renseigne au minimum la clé Anthropic.

# Obligatoire — https://platform.claude.com/ → API keys
ANTHROPIC_API_KEY=

# Optionnel — active la source YouTube du radar (quota gratuit 10 000 unités/jour)
# https://console.cloud.google.com/ → activer "YouTube Data API v3" → créer une clé
YOUTUBE_API_KEY=

# Optionnel — valeurs par défaut
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high        # low | medium | high | xhigh | max
# TREND_GEO=FR              # pays des tendances Google/YouTube
# TREND_LANG=fr             # langue du filtre actualité
# PORT=3344
