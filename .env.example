# Copie ce fichier vers .env puis renseigne au minimum la clé Anthropic.

# Obligatoire — https://platform.claude.com/ → API keys
ANTHROPIC_API_KEY=

# Optionnel — active la source YouTube du radar et l'analyse des chaînes (quota gratuit 10 000 unités/jour)
# https://console.cloud.google.com/ → activer "YouTube Data API v3" → créer une clé
YOUTUBE_API_KEY=

# Optionnel — onglets « Idées » et « Comptes » : relevé TikTok, Instagram, X et LinkedIn via Apify
# https://console.apify.com/settings/integrations → Personal API token
# Coût ≈ 0,30 $ de crédit par scan, 0,02 à 0,12 $ par analyse de compte (offre gratuite : 5 $/mois)
APIFY_TOKEN=

# Optionnel sur Vercel — protège la tâche planifiée du scan quotidien
# CRON_SECRET=

# Optionnel — Claude dans « Idées »
# CLAUDE_ANALYSIS_MODEL=claude-haiku-5-5   # lecture des posts moins chère (défaut : CLAUDE_MODEL)
# CLAUDE_WEB_RESEARCH=off                  # coupe la veille web avant chaque scan

# Optionnel — valeurs par défaut
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high        # low | medium | high | xhigh | max
# TREND_GEO=FR              # pays des tendances Google/YouTube
# TREND_LANG=fr             # langue du filtre actualité
# PORT=3344

# Optionnel en local, requis sur Vercel : stockage Redis (Upstash)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
